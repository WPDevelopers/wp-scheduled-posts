<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unit suite: pure PHP, no WordPress, no database.

  failOnEmptyTestSuite and failOnWarning are deliberate. A run that discovers
  no tests used to exit 0, which reads as passing evidence for work that was
  never verified.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/bootstrap-unit.php"
         colors="true"
         failOnEmptyTestSuite="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests/unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
